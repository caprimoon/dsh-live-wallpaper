{
  "name": "@caprimoon/dsh-live-wallpaper",
  "version": "1.2.3",
  "private": true,
  "type": "module",
  "description": "Dynamic wallpaper and glass panels for the DeepSeek Harness web GUI: five-source video gallery, local media import, offline canvas scenes, and six independently adjustable glass zones with backdrop blur.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "host",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "license": "MIT",
  "author": "caprimoon",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caprimoon/dsh-live-wallpaper.git"
  },
  "homepage": "https://github.com/caprimoon/dsh-live-wallpaper#readme",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "wallpaper",
    "glassmorphism",
    "live-wallpaper",
    "plugin"
  ]
}
